# Copiar a `.env` y rellenar. El `.env` NO se sube a git ni entra en la imagen
# de Docker (está en `.gitignore` y en `.dockerignore`).
#
# Aquí van SOLO los secretos y las rutas. Las reglas de entrenamiento -series,
# cargas, frenos, horarios, calendario- viven en `config.yaml`, que sí se
# versiona. Si algo se puede contar en un commit, no va aquí.
#
# Este fichero es la lista COMPLETA de ajustes que entiende `app/settings.py`.
# Cualquier otra clave se rechaza al arrancar en vez de ignorarse, y una que se
# parezca mucho a una de estas (`DRY_RUM`, `LOGLEVEL`) también: un ajuste mal
# escrito que se ignora en silencio es un ajuste que no has puesto sin que
# nadie te lo diga.

# --- Garmin ---------------------------------------------------------------
# La cuenta de siempre. El login guarda un token en `data/garmin_tokens` para
# no repetirlo en cada arranque: Garmin responde 429 si se insiste.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Dónde se guarda ese token. Tiene que caer DENTRO del volumen persistente, o
# cada reinicio vuelve a hacer login y Garmin acaba contestando 429.
# Por defecto: data/garmin_tokens
# GARMIN_TOKEN_DIR=

# --- Hevy -----------------------------------------------------------------
# Ajustes -> Developer -> API key (hace falta Hevy Pro).
HEVY_API_KEY=
# Solo para apuntar a un servidor distinto (pruebas). Por defecto:
# HEVY_API_BASE=https://api.hevyapp.com

# --- Telegram -------------------------------------------------------------
# El token lo da @BotFather al crear el bot. El chat_id se saca escribiéndole
# al bot y mirando https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Rutas ----------------------------------------------------------------
# Las dos tienen valor por defecto y casi nunca hay que tocarlas. Están aquí
# porque no estarlo no las hacía inexistentes, solo invisibles: quien montara
# el volumen en otro sitio no tenía forma de saber que se podían mover.
# Por defecto: config.yaml (en Docker se monta desde fuera, ver compose)
# CONFIG_PATH=
# Por defecto: sqlite:///data/app.db — DENTRO del volumen, o el histórico y las
# copias de las rutinas de Hevy se pierden en cada `docker compose up`.
# DATABASE_URL=

# --- Comportamiento -------------------------------------------------------
# `true` = decide, guarda y registra, pero NO escribe en Hevy ni envía Telegram.
# Empieza en `true` y déjalo así hasta fiarte de lo que decide; el valor de
# este fichero decía `false` mientras el comentario recomendaba lo contrario.
# Ojo: quitar la línea NO es "sin decidir", es `false`.
DRY_RUN=true

# Los tres trabajos del día (Garmin 06:30, decisión 09:00, reconciliar 22:30).
# Dejarlo en `true`. En `false` la aplicación sirve el formulario y no hace
# nada más: no decide sola, que es justo para lo que existe.
SCHEDULER_ENABLED=true

# DEBUG para ver por qué el motor ha decidido lo que ha decidido.
LOG_LEVEL=INFO

# --- Quién protege la puerta ----------------------------------------------
# La aplicación NO tiene autenticación propia y no va a tenerla: en Umbrel el
# `app_proxy` ya pone un login, y otro por dentro serían dos contraseñas para
# la misma puerta. O sea que quien protege esto vive siempre FUERA, y desde
# dentro del contenedor no hay forma de comprobarlo: estar detrás del
# `app_proxy` y estar publicado en crudo se ven exactamente igual.
#
# Como no se puede comprobar, se declara aquí, y el arranque lo deja dicho en
# el log. Los tres valores:
#
#   (sin poner)  se avisa, porque nadie ha dicho qué hay delante
#   ninguna      se avisa igual, pero diciendo que es a propósito
#   proxy        hay un proxy con login delante; se anota y no se avisa
#
# El defecto es el ruidoso a propósito: un despliegue nuevo que nadie
# configure se queja solo. `proxy` es lo único que quita el aviso, así que
# ponerlo sin tener un proxy delante es mentirse por escrito.
# AUTH_FRONT=

# --- No son ajustes de la aplicación: son de `docker compose` --------------
# `docker compose` lee sus propias variables de este mismo fichero, y
# COMPOSE_FILE es la que hace que el comando corto -`docker compose up -d`-
# use los DOS ficheros de compose en vez de solo el de la raíz.
#
# EN UMBREL ESTO SE DEJA VACÍO. Allí el compose de la raíz es el bueno y no hay
# superposición ninguna: poner esto rompería el despliegue.
#
# EN EL PC DE PRUEBAS hace falta, y hizo falta por las malas. Sin la
# superposición, el compose de la raíz monta `./data` como bind mount de
# Windows en vez del volumen nombrado `datos-pruebas`, y el contenedor arranca
# contra otra base de datos diciendo `status: ok`. Que los dos `-f` eran
# obligatorios estaba escrito en el README y en este fichero, y el comando
# corto rompió el estado igualmente dos veces, el 12 y el 13 de septiembre.
# Un aviso escrito no para a nadie; lo que para es que el comando equivocado
# deje de existir.
#
#   COMPOSE_PATH_SEPARATOR=:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.pruebas-lan.yml
#
# El separador va explícito porque Compose usa `;` en Windows y `:` en el
# resto, y este fichero lo leen las dos cosas.
#
# Están declarados en `app/settings.py` como campos que NO se leen. Es por
# `extra="forbid"`, que existe para que `DRY_RUM` sea un error y no un ajuste
# inventado: sin declararlos, forbid rechazaría el fichero entero y no
# arrancaría ni la CLI ni la batería de tests.
# COMPOSE_PATH_SEPARATOR=
# COMPOSE_FILE=
