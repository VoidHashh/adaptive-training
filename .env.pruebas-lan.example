# TEMPORAL: credenciales del proxy de la fase de pruebas en el PC.
# Se copia a `.env.pruebas-lan` (que NO se sube a git) y se rellena.
#
# Este fichero es SOLO del proxy. No mezclar con el `.env` de la aplicación:
# `app/settings.py` lo valida con `extra="forbid"` y una clave que no conoce
# hace que se niegue a arrancar.

LOCAL_USER=roolez

# El hash, no la contraseña. Se genera con:
#
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'la-que-sea'
#
# Empieza por `$2a$14$`. Se pega tal cual, sin comillas: un `env_file` no lo
# interpola nadie, así que los `$` no hay que escaparlos aquí.
#
# Si se deja vacío, Caddy NO ARRANCA. Es deliberado: mejor un proxy que no
# levanta -y que se nota al primer intento desde el móvil- que uno que levanta
# sin contraseña y publica el histórico en la red de casa sin decirlo.
LOCAL_PASSWORD_HASH=
