# Secrets — NEVER commit
.env

# Credenciales del proxy de la fase de pruebas (el `.example` sí se sube).
# Va suelto y no como `.env.*` para que el día que alguien añada otro fichero
# de entorno tenga que decidir a conciencia si se sube o no.
.env.pruebas-lan

# Runtime data (SQLite, tokens de Garmin, caché de actividades reales)
# La caché contiene el histórico de entrenamientos del usuario: NUNCA se sube.
data/*
!data/.gitkeep

# Previous hevy2garmin trial, kept out of the repo
legacy/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/settings.local.json

# Borrador del mensaje del commit en curso, no forma parte del proyecto
/COMMIT_MSG.txt

# Salidas de ejecuciones manuales (pueden contener datos del usuario)
/out.txt
*.out.txt
/Nuevo Documento de texto.txt

# `scripts/ver_panel.py` deja aquí el panel pintado contra la base de VERDAD:
# HRV, sueño, salidas, check-ins y lo que el motor decidió, en HTML y en JSON.
# Es exactamente el mismo dato que `data/` y se trata igual de mal que él.
/out/
